# QA Platforms 环境配置示例
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，请勿提交真实密钥）

# ---- LLM 网关（OpenAI 兼容协议；指向你的自建网关）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_PRIMARY_MODEL=
# 视觉与校验可完全独立；地址/Key 留空时兼容回退主网关
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
LLM_VISION_MODEL=
LLM_VERIFY_BASE_URL=
LLM_VERIFY_API_KEY=
LLM_VERIFY_MODEL=
# 主模型失败重试次数（不会切换到其它模型，只重试主模型）
LLM_MAX_RETRIES=2
# [当前部署推荐 8] test-points / write-cases 的 LLM 并发数。
# 当前网关已按 8 并发使用；换网关或遇到 429/超时时，先降到 2~4 再压测。
LLM_CONCURRENCY=8
# [推荐关闭] 当前自建网关对 response_format=json_object 为不完整兼容，
# 开启可能返回空 content；仅在目标网关真实支持 JSON mode 并完成验证后开启。
LLM_JSON_MODE=false

# ---- 页面化模型设置 ----
# 使用 Fernet.generate_key() 生成；API 与 Worker 必须配置同一个值
MODEL_CONFIG_ENCRYPTION_KEY=
MODEL_CONNECTION_TEST_TIMEOUT=20

# ---- Embedding（留空则自动复用上面的 LLM 网关）----
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=
# 兼容旧字段，作为各处 key 的最终回退（如果只用一套网关，可不填）
OPENAI_API_KEY=

# ---- 用例生成生产开关 ----
# 生效规则：
# 1. 修改后必须同时重启 API 与 Worker；只重启前端不会生效。
# 2. 新批次的 generation_config 优先于这里的全局默认值；旧批次继续使用创建时保存的配置。
# 3. 以下推荐值对应当前网关能力和 best_practice_default_2026_07 质量档案。

# 解析与知识增强
# [有视觉模型时推荐开启] 为 PRD 图片补充可追溯描述；未配置 LLM_VISION_MODEL 时应关闭。
IMAGE_CAPTION_ENABLED=true
# [推荐开启] 解析实体与关系，为实体检索、速查表和冲突判断提供结构化依据。
ENTITY_GRAPH_ENABLED=true
# [推荐开启] 在生成上下文中补充实体关系提示；失败时返回空结果，不阻断主链路。
ENTITY_RETRIEVAL_ENABLED=true
# [推荐开启] 对测试点批失败进行重试和缺额校验，避免功能点静默丢失。
TEST_POINTS_COMPLETENESS_GUARD=true

# [推荐开启] 允许人工触发实体图谱到知识速查表的提取。
CHEAT_SHEET_EXTRACT_ENABLED=true
# [推荐开启] 仅把审核状态为 approved 的速查表条目注入生成；
# pending/rejected 条目不会进入提示词，因此可与人工审核门禁同时启用。
CHEAT_SHEET_INJECTION_ENABLED=true

# [当前部署推荐开启] 使用关键词 + 向量 + RRF 做跨功能点规格召回，
# 可补足同义表达的漏召回；会增加 embedding 调用和噪声候选，应持续观察召回质量与成本。
HYBRID_CROSS_RETRIEVAL_ENABLED=true
# RRF 默认 60 是保守融合值；没有离线评估证据时不建议随意调整。
HYBRID_CROSS_RRF_K=60

# 规则锚定质量链：必须按以下完整依赖链一起开启。
# [推荐开启] 先抽取规则台账，是规则驱动测试点、覆盖门和安全去重的前置。
RULE_EXTRACT_ENABLED=true
# [推荐开启] 按规则生成测试点并增强维度；依赖 RULE_EXTRACT_ENABLED。
RULE_DRIVEN_TESTPOINTS_ENABLED=true
# [推荐开启] 检查规则级覆盖并定向补齐；依赖前两项。
RULE_COVERAGE_GATE_ENABLED=true
# [推荐开启] 在规则保护下去重，避免误删某条规则的最后一个代表用例；依赖规则链。
SAFE_DEDUP_ENABLED=true

# [推荐开启] 补充权限矩阵、状态迁移和关键流程的结构化覆盖。
STRUCTURAL_COVERAGE_ENABLED=true
# [推荐开启] 在生成期校验 source_ref/source_quote，降低无依据断言进入后续阶段的概率。
GROUNDED_PROVENANCE_ENABLED=true

# 校验与判定保护
# [推荐开启] 识别同一 PRD 不同章节间的实质冲突，并保留两侧证据。
VERIFY_CROSS_SECTION_CONFLICT_ENABLED=true
# [推荐开启] 防止把不同业务实体误判为同字段冲突。
CONFLICT_ENTITY_GATE_ENABLED=true
# [推荐开启] 将无依据的具体 toast、状态码、实现机制等断言降级为待补规格，不直接删除。
ORACLE_GUARD_ENABLED=true
# [推荐开启] 对同构用例统一 verdict；当前阈值已有离线批次验证。
VERDICT_RECONCILE_ENABLED=true
# [推荐开启] 只对 conflict 子集复判，降低单次模型抖动；会增加少量校验调用成本。
CONFLICT_REVOTE_ENABLED=true
REVOTE_N=3

# 生成收敛
# [推荐开启] 限制单测试点拆出的用例数量，同时优先保留不同覆盖维度和边界代表。
SPLIT_CAP_ENABLED=true
# 当前评估推荐 4；3 更容易裁掉独立维度，过高则难以抑制灌水。
CASES_PER_TP_CAP=4
# [推荐开启] 合并同测试点、同来源下的纯存在性检查，保留全部检查点。
EXISTENCE_MERGE_ENABLED=true
# [推荐关闭] 强制 P0 配额会人为改变业务优先级；先保留真实风险分级，单独评估后再开启。
P0_QUOTA_ENABLED=false
P0_QUOTA=0.30

# 实验开关：当前不进入生产默认档案
# [推荐关闭] embedding 语义去重仍有误合并独立断言的风险；完成跨 PRD 误伤评估后再开启。
SEMANTIC_DEDUP_ENABLED=false
# [推荐关闭] LLM 全局章节判定尚缺跨 PRD 稳定性验证，关闭时使用现有关键词并有确定性行为。
GLOBAL_SECTION_LLM_ENABLED=false
# [推荐关闭] LLM 自适应功能点切分尚缺跨 PRD 粒度验证，关闭时沿用确定性标题层级规则。
FEATURE_SEG_LLM_ENABLED=false

# ---- 基础设施 ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/qa_platforms
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=qa-documents
MINIO_SECURE=false

DEBUG=false
