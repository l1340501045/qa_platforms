# QA Platforms 环境配置示例
# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，请勿提交真实密钥）

# ---- LLM 网关（OpenAI 兼容协议；指向你的自建网关）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_PRIMARY_MODEL=
# 主模型失败重试次数（不会切换到其它模型，只重试主模型）
LLM_MAX_RETRIES=2

# ---- Embedding（留空则自动复用上面的 LLM 网关）----
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=
# 兼容旧字段，作为各处 key 的最终回退（如果只用一套网关，可不填）
OPENAI_API_KEY=

# ---- 基础设施 ----
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/qa_platforms
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=qa-platforms
MINIO_SECURE=false

DEBUG=false
