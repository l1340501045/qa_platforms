# QA Platforms 生产 Docker 环境配置示例
# 复制为 .env.prod 后填入真实值；.env.prod 不要提交。

# ---- LLM 网关（OpenAI 兼容协议；指向公司内网网关）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_PRIMARY_MODEL=claude-opus-4-6
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
LLM_VISION_MODEL=claude-opus-4-6
LLM_VERIFY_BASE_URL=
LLM_VERIFY_API_KEY=
LLM_VERIFY_MODEL=deepseek-v4-pro-office
LLM_CONCURRENCY=8
LLM_MAX_RETRIES=2

# ---- 页面化模型设置（API 与 Worker 必须使用同一个 Fernet Key）----
MODEL_CONFIG_ENCRYPTION_KEY=
MODEL_CONNECTION_TEST_TIMEOUT=20

# ---- Embedding（留空则自动复用上面的 LLM 网关）----
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=
OPENAI_API_KEY=

# ---- Docker 内网基础设施 ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=qa_platforms
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/qa_platforms

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=qa-documents
MINIO_SECURE=false

DEBUG=false
